{
  "name": "hey-cape-cod-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for Hey Cape Cod iOS app — POIs, stories, traffic, weather, tides, AI chat, and voice relay",
  "scripts": {
    "dev": "vercel dev",
    "seed": "node scripts/seed-database.js",
    "test": "node --test tests/**/*.test.js",
    "deploy": "vercel --prod",
    "deploy:staging": "vercel",
    "smoke": "node tests/smoke.test.js",
    "deploy:full": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@vercel/kv": "^1.0.0",
    "cors": "^2.8.5",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.1.0",
    "openai": "^4.52.0",
    "sanitize-html": "^2.12.0",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "vercel": "^33.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
