rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Users ---
    // Users can only read/write their own profile
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                       .hasAny(['isPremium', 'premiumExpiresAt', 'createdAt', 'uid']);
      allow delete: if false; // Users cannot delete their own profiles
    }

    // --- POIs ---
    // Public read, admin write only
    match /pois/{poiId} {
      allow read: if true;
      allow write: if false; // Only server-side via Admin SDK
    }

    // --- Stories ---
    // Public read, admin write only
    match /stories/{storyId} {
      allow read: if true;
      allow write: if false; // Only server-side via Admin SDK
    }

    // --- Traffic Cache ---
    // Public read (cached data), server write only
    match /traffic_cache/{docId} {
      allow read: if true;
      allow write: if false; // Only server-side via Admin SDK
    }

    // --- Spending ---
    // Server-side only (cost tracking)
    match /spending/{docId} {
      allow read, write: if false; // Only server-side via Admin SDK
    }

    // --- Metrics ---
    // Server-side only (usage metrics)
    match /metrics/{docId} {
      allow read, write: if false; // Only server-side via Admin SDK
    }

    // --- Alerts ---
    // Server-side only (spending alerts)
    match /alerts/{docId} {
      allow read, write: if false; // Only server-side via Admin SDK
    }

    // --- Health Check ---
    // Server-side only
    match /health/{docId} {
      allow read, write: if false; // Only server-side via Admin SDK
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
