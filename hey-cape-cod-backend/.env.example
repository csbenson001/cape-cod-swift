# Hey Cape Cod Backend — Environment Variables
# Copy to .env and fill in real values

# OpenAI
OPENAI_API_KEY=sk-...

# Firebase Admin SDK
FIREBASE_PROJECT_ID=hey-cape-cod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@hey-cape-cod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# Google Maps (traffic fallback)
GOOGLE_MAPS_API_KEY=AIza...

# Vercel KV (optional — falls back to in-memory cache)
VERCEL_KV_URL=redis://...

# NOAA API User-Agent (required by api.weather.gov)
NOAA_USER_AGENT=HeyCapeCodeApp/1.0 (contact@heycapecod.com)
