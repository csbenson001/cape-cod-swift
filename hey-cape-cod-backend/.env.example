# Hey Cape Cod Backend — Environment Variables
#
# Copy to .env and fill in values for local development.
# For production, set these in Vercel dashboard > Settings > Environment Variables.

# OpenAI
OPENAI_API_KEY=sk-...

# Firebase Admin SDK
FIREBASE_PROJECT_ID=hey-cape-cod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@hey-cape-cod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# Google Maps (traffic fallback)
GOOGLE_MAPS_API_KEY=AIza...

# Vercel KV (Redis) — optional, falls back to in-memory cache
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=...

# NOAA API user agent (required by NOAA terms of service)
NOAA_USER_AGENT=HeyCapeCodeApp/1.0 (contact@heycapecod.com)

# Voice Relay Server URL (Railway/Render/Fly.io)
VOICE_RELAY_URL=wss://voice.heycapecod.com/relay

# Cost Controls
USER_DAILY_CAP=1.00

# Logging
LOG_LEVEL=info

# Environment
NODE_ENV=development
